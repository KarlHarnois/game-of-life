(export ->delay ->position ->settings ->size args->settings
        cell cell-at delay grid grid->text
        grid-with-live-cells live-neighbor-count next-cell
        pattern position seed settings settings-error size
        step)

(defenum cell
  alive
  dead)

(defstruct size
  :width int
  :height int)

(defstruct position
  :row int
  :column int)

(defstruct grid
  :size size
  :cells (vec cell))

(defenum pattern
  glider
  blinker
  r-pentomino)

(defstruct delay
  :milliseconds int)

(defstruct settings
  :grid-size size
  :generations int
  :delay delay
  :pattern pattern)

(defenum settings-error
  (unknown-pattern string)
  (invalid-generations (parse-error int)))

(def survival-counts
  (the (vec usize) (vec 2 3)))

(def birth-counts
  (the (vec usize) (vec 3)))

(def neighbor-offsets
  (vec (->position :row -1 :column -1)
       (->position :row -1 :column 0)
       (->position :row -1 :column 1)
       (->position :row 0 :column -1)
       (->position :row 0 :column 1)
       (->position :row 1 :column -1)
       (->position :row 1 :column 0)
       (->position :row 1 :column 1)))

(def all-patterns
  (vec pattern/glider pattern/blinker pattern/r-pentomino))

(def int->index
  (rust "({0} as usize)" (fn (int) usize)))

(defn step (grid)
  (->grid :size (:size grid)
          :cells (-> (positions (:size grid))
                     (map (fn (position) (next-generation-cell grid position)))
                     collect)))

(defn next-generation-cell (grid position)
  (next-cell (cell-at grid position)
             (live-neighbor-count grid position)))

(defn next-cell (cell live-neighbors)
  (match cell
    (alive (survivor live-neighbors))
    (dead (newborn live-neighbors))))

(type survivor (fn (usize) cell))

(defn survivor (live-neighbors)
  (if (contains? survival-counts live-neighbors)
    cell/alive cell/dead))

(type newborn (fn (usize) cell))

(defn newborn (live-neighbors)
  (if (contains? birth-counts live-neighbors)
    cell/alive cell/dead))

(defn live-neighbor-count (grid position)
  (-> neighbor-offsets
      (map (fn (offset)
             (cell-at grid (translate position offset))))
      (filter (fn (cell) (alive? (deref cell))))
      count))

(defn alive? (cell)
  (match cell (alive true) (dead false)))

(defn translate (position offset)
  (->position :row (+ (:row position) (:row offset))
              :column (+ (:column position) (:column offset))))

(type cell-at
  (fn ((ref grid) (ref position)) cell))

(defn cell-at (grid position)
  (let (size (:size grid)
        index (cell-index size (wrap-position size position)))
    (deref (at (:cells grid) (int->index index)))))

(defn cell-index (size position)
  (+ (* (:row position) (:width size))
     (:column position)))

(defn wrap-position (size position)
  (->position :row (wrap (:row position) (:height size))
              :column (wrap (:column position) (:width size))))

(defn wrap (value limit)
  (rem (+ (rem value limit) limit) limit))

(defn positions (size)
  (let (width (:width size))
    (-> (range 0 (* width (:height size)))
        (map (fn (index)
               (->position :row (/ index width) :column (rem index width))))
        collect)))

(defn grid-with-live-cells (size live-positions)
  (->grid :size size
          :cells (-> (positions size)
                     (map (fn (position)
                            (cell-of-position live-positions (deref position))))
                     collect)))

(defn cell-of-position (live-positions position)
  (if (contains? live-positions position)
    cell/alive cell/dead))

(defn seed (size pattern)
  (let (center (->position :row (dec (/ (:height size) 2))
                           :column (dec (/ (:width size) 2)))
        live-positions (-> (pattern-offsets pattern)
                           (map (fn (offset) (translate center offset)))
                           collect))
    (grid-with-live-cells size live-positions)))

(defn pattern-offsets (pattern)
  (match pattern
    (glider (vec (offset 0 1)
                 (offset 1 2)
                 (offset 2 0)
                 (offset 2 1)
                 (offset 2 2)))
    (blinker (vec (offset 1 0) (offset 1 1) (offset 1 2)))
    (r-pentomino (vec (offset 0 1)
                      (offset 0 2)
                      (offset 1 0)
                      (offset 1 1)
                      (offset 2 1)))))

(defn offset (row column)
  (->position :row row :column column))

(defn grid->text (grid)
  (-> (range 0 (:height (:size grid)))
      (map (fn (row) (row->text grid row)))
      collect
      (join "\n")))

(defn row->text (grid row)
  (-> (range 0 (:width (:size grid)))
      (map (fn (column)
             (cell->text (cell-at grid (->position :row row :column column)))))
      collect
      (join "")))

(defn cell->text (cell)
  (match cell (alive "#") (dead ".")))

(defn args->settings (args defaults)
  (let-try (pattern (pattern-argument args (:pattern defaults))
            generations (generations-argument args (:generations defaults)))
    (ok (assoc defaults :pattern pattern :generations generations))))

(defn pattern-argument (args default)
  (match (get args 0)
    ((some text) (text->pattern (as-str text)))
    (none (ok default))))

(defn generations-argument (args default)
  (match (get args 1)
    ((some text) (text->generations (as-str text)))
    (none (ok default))))

(defn text->pattern (text)
  (-> all-patterns
      (find (fn (pattern)
              (= (pattern->text (deref pattern)) text)))
      (map-some (fn (pattern) (deref pattern)))
      (ok-or (settings-error/unknown-pattern (str text)))))

(defn pattern->text (pattern)
  (match pattern
    (glider "glider")
    (blinker "blinker")
    (r-pentomino "r-pentomino")))

(type text->generations
  (fn ((ref str))
    (result int settings-error)))

(defn text->generations (text)
  (ok (try (parse text))))
