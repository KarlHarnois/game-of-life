(export pattern seed text->pattern)

(use board ->offset ->position grid-with-live-cells
           translate)

(defenum pattern
  glider
  blinker
  r-pentomino)

(def all-patterns
  (vec pattern/glider pattern/blinker pattern/r-pentomino))

(defn seed (size pattern)
  (let (center (->position :row (dec (/ (:height size) 2))
                           :column (dec (/ (:width size) 2)))
        live-positions (-> (pattern-offsets pattern)
                           (map (fn (offset) (translate center offset)))
                           collect))
    (grid-with-live-cells size live-positions)))

(defn pattern-offsets (pattern)
  (match pattern
    (glider (vec (offset-by 0 1)
                 (offset-by 1 2)
                 (offset-by 2 0)
                 (offset-by 2 1)
                 (offset-by 2 2)))
    (blinker (vec (offset-by 1 0)
                  (offset-by 1 1)
                  (offset-by 1 2)))
    (r-pentomino (vec (offset-by 0 1)
                      (offset-by 0 2)
                      (offset-by 1 0)
                      (offset-by 1 1)
                      (offset-by 2 1)))))

(defn offset-by (rows columns)
  (->offset :rows rows :columns columns))

(defn text->pattern (text)
  (-> all-patterns
      (find (fn (pattern)
              (= (pattern->text (deref pattern)) text)))
      (map-some (fn (pattern) (deref pattern)))))

(defn pattern->text (pattern)
  (match pattern
    (glider "glider")
    (blinker "blinker")
    (r-pentomino "r-pentomino")))
