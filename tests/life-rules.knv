(use life ->delay ->position ->settings ->size
          args->settings cell cell-at grid->text
          grid-with-live-cells live-neighbor-count next-cell
          pattern seed settings-error step)

(defn square (side) (->size :width side :height side))

(defn at-cell (row column)
  (->position :row row :column column))

(defn grid-of (side live-cells)
  (grid-with-live-cells (square side) live-cells))

(defn horizontal-blinker ()
  (grid-of 5
           (vec (at-cell 2 1)
                (at-cell 2 2)
                (at-cell 2 3))))

(defn vertical-blinker ()
  (grid-of 5
           (vec (at-cell 1 2)
                (at-cell 2 2)
                (at-cell 3 2))))

(defn step-times (grid times)
  (loop (current grid
         remaining times)
    (if (> remaining 0)
      (recur (step current) (dec remaining))
      current)))

(defn test-settings ()
  (->settings :grid-size (square 8)
              :generations 100
              :delay (->delay :milliseconds 0)
              :pattern pattern/glider))

(deftest blinker-turns-vertical
  (assert (= (step (horizontal-blinker))
             (vertical-blinker))))

(deftest blinker-turns-back-horizontal
  (assert (= (step-times (horizontal-blinker) 2)
             (horizontal-blinker))))

(deftest block-stays-still
  (let (block (grid-of 4
                       (vec (at-cell 1 1)
                            (at-cell 1 2)
                            (at-cell 2 1)
                            (at-cell 2 2))))
    (assert (= (step (clone block)) block))))

(deftest glider-wraps-around-the-torus
  (let (start (seed (square 8) pattern/glider))
    (assert (= (step-times (clone start) 32) start))))

(deftest glider-moves-away-before-wrapping
  (let (start (seed (square 8) pattern/glider))
    (assert (not= (step-times (clone start) 4) start))))

(deftest neighbor-count-wraps-across-corners
  (let (grid (grid-of 4 (vec (at-cell 3 3))))
    (assert (= (live-neighbor-count grid (at-cell 0 0)) 1))))

(deftest cell-at-wraps-negative-positions
  (let (grid (grid-of 4 (vec (at-cell 3 3))))
    (assert (= (cell-at grid (at-cell -1 -1)) cell/alive))))

(deftest lonely-cell-dies
  (assert (= (next-cell cell/alive 1) cell/dead)))

(deftest cell-with-two-neighbors-survives
  (assert (= (next-cell cell/alive 2) cell/alive)))

(deftest cell-with-three-neighbors-survives
  (assert (= (next-cell cell/alive 3) cell/alive)))

(deftest crowded-cell-dies
  (assert (= (next-cell cell/alive 4) cell/dead)))

(deftest dead-cell-with-three-neighbors-is-born
  (assert (= (next-cell cell/dead 3) cell/alive)))

(deftest dead-cell-with-two-neighbors-stays-dead
  (assert (= (next-cell cell/dead 2) cell/dead)))

(deftest grid-renders-as-text
  (assert (= (grid->text (grid-of 2 (vec (at-cell 0 1))))
             ".#\n..")))

(deftest no-arguments-keep-defaults
  (assert (= (unwrap-ok (args->settings (vec) (test-settings)))
             (test-settings))))

(deftest arguments-set-pattern-and-generations
  (let (expected (->settings :grid-size (square 8)
                             :generations 5
                             :delay (->delay :milliseconds 0)
                             :pattern pattern/blinker))
    (assert (= (unwrap-ok (args->settings (vec (str "blinker") (str "5"))
                                          (test-settings)))
               expected))))

(deftest unknown-pattern-is-an-error
  (assert (= (pr-str (unwrap-err (args->settings (vec (str "nope"))
                                                 (test-settings))))
             (pr-str (settings-error/unknown-pattern (str "nope"))))))

(deftest bad-generations-is-an-error
  (assert (err? (args->settings (vec (str "glider") (str "many"))
                                (test-settings)))))
